{
  "manifest_version": 3,
  "name": "Biblib : ce livre est-il dans ma bibliothèque ?",
  "short_name": "Biblib",
  "version": "1.0.0",
  "description": "Sur la fiche d'un livre (Amazon, Babelio…), voyez s'il est dans vos bibliothèques, s'il est disponible, et réservez-le.",
  "homepage_url": "https://github.com/Bublex/biblib",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Biblib",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://bibliotheques.paris.fr/*",
    "https://bibliotheque.bordeaux.fr/*",
    "https://catalogue.bm-lyon.fr/*",
    "https://www.bmvr.marseille.fr/*",
    "http://catalogues.toulouse.fr/*",
    "https://bmvr.nice.fr/*",
    "https://catalogue-bibliotheque.nantes.fr/*",
    "https://mediatheques.montpellier3m.fr/*",
    "https://www.mediatheques.strasbourg.eu/*",
    "https://bm-lille.fr/*",
    "https://opac.si.leschampslibres.fr/*",
    "https://sbib.si.leschampslibres.fr/*",
    "https://bm-grenoble.fr/*",
    "https://www.agen-mediatheque.fr/*",
    "https://bibliotheque.ajaccio.fr/*",
    "https://mediatheque.ville-arles.fr/*",
    "https://mediatheques.arlysere.fr/*",
    "https://mediatheque.aubagne.fr/*",
    "https://reseaudesbibliotheques.aulnay-sous-bois.fr/*",
    "https://www.mediatheque-avion.fr/*",
    "https://www.mediatheque-biarritz.fr/*",
    "https://mediatheques.boulognebillancourt.com/*",
    "https://mediatheque.ville-bourges.fr/*",
    "https://mediatheque.bruaylabuissiere.fr/*",
    "https://mediatheque.brysurmarne.fr/*",
    "https://mediatheque.cagnes.fr/*",
    "https://portail-mediatheque.capi-agglo.fr/*",
    "https://www.mediatheque-cesson-sevigne.fr/*",
    "https://e-changes.cholet.fr/*",
    "https://mediatheque.ville-coueron.fr/*",
    "https://mediatheque-anne-frank.fr/*",
    "https://bm.dijon.fr/*",
    "https://mediatheques.ladomitienne.com/*",
    "https://mediatheque-douarnenez.fr/*",
    "https://dugny.syracuse.cloud/*",
    "http://syracuse.sitpi.fr/*",
    "https://mediatheques.evreux.fr/*",
    "https://mediatheque.fontainebleau.fr/*",
    "https://mediatheques.fougeres-agglo.bzh/*",
    "https://mediatheques.legrandnarbonne.com/*",
    "https://www.mediathequesludotheques.grandorlyseinebievre.fr/*",
    "https://www.mediatheques-grandpoitiers.fr/*",
    "https://www.mediatheques-rcm.fr/*",
    "https://www.mediatheque.issoudun.fr/*",
    "https://www.bibliothequemunicipaledelafleche.fr/*",
    "https://mediatheques.agglo-larochelle.fr/*",
    "https://mediatheque.ville-port.re/*",
    "https://www.mediatheque-tampon.fr/*",
    "https://mediatheque.lormont.fr/*",
    "https://mediatheque.macon.fr/*",
    "https://mediatheque.malakoff.fr/*",
    "https://corderie.marcq-en-baroeul.fr/*",
    "https://mediatheque.ville-massy.fr/*",
    "https://www.mediatheque.merignac.com/*",
    "https://mediatheque.mairie-muret.fr/*",
    "https://www.bm-reims.fr/*",
    "https://www.reseau-m.fr/*",
    "https://www.mediatheque-rumilly74.fr/*",
    "https://mediatheques.saint-etienne.fr/*",
    "https://smwe-mdsl.syracuse.cloud/*",
    "https://mediatheque-saint-louis.syracuse.cloud/*",
    "https://bibliotheque.sceaux.fr/*",
    "https://mediatheques.toulon.fr/*",
    "https://biblio.vevey.ch/*",
    "https://mediatheque.villemomble.fr/*",
    "https://mediatheques.villenavedornon.fr/*",
    "https://cataloguebm.villeurbanne.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.fr/*",
        "https://www.amazon.com/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.es/*",
        "https://www.amazon.it/*",
        "https://www.babelio.com/*",
        "https://www.bedetheque.com/*",
        "https://www.fnac.com/*",
        "https://livre.fnac.com/*",
        "https://www.decitre.fr/*",
        "https://www.cultura.com/*",
        "https://www.leslibraires.fr/*",
        "https://www.placedeslibraires.fr/*",
        "https://www.mollat.com/*",
        "https://www.gibert.com/*",
        "https://www.furet.com/*",
        "https://www.chasse-aux-livres.fr/*",
        "https://www.bdfugue.com/*",
        "https://www.goodreads.com/*",
        "https://www.senscritique.com/*",
        "https://openlibrary.org/*"
      ],
      "js": ["content/extract.js", "content/ui.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
